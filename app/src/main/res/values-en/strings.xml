    <string name="context_offers_title">Context suggestions</string>
    <string name="context_offers_summary">When a word looks wrong for its sentence (caza instead of casa), the bar offers the other one · one tap swaps it · the keyboard never changes it on its own · offline</string>
    <string name="context_offer_desc">Replace %1$s with %2$s</string>
